# ⚠️ LOCAL DEVELOPMENT ONLY. The keypairs referenced below are committed to the repository
#    (solana/keys/dev) and are public. NEVER use them, or this seed secret, outside localnet.

SOLANA_RPC_URL=http://localhost:8899

# House settler key: opens player accounts, commits and reveals server seeds (paths relative to the repo root)
HOUSE_KEYPAIR=solana/keys/dev/house.json
# Dev faucet treasury (holds the HROLL supply on localnet)
FAUCET_KEYPAIR=solana/keys/dev/admin.json

# Root secret that derives every server seed (>= 32 characters). Leaking it reveals all future rolls.
HOUSE_SEED_SECRET=879b792653c6af297d936ae8c779119c32dc7c8d1a47e0dfec05123eace90773

# Set to false to run the API without the settler loop
SETTLER_ENABLED=true

DATABASE_URL=postgres://hashroll:hashroll@localhost:5432/hashroll
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
